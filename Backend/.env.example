# Copy this file to .env (gitignored) and fill in real values.
# NEVER commit the .env file with real secrets.

# Flask environment: "development" or "production"
FLASK_ENV=development

# Required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret

# Required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=replace-with-a-strong-random-secret

# OpenRouter AI model keys (get from https://openrouter.ai)
OPENROUTER_API_KEY_PRIMARY=sk-or-v1-...
OPENROUTER_API_KEY_SECONDARY=sk-or-v1-...

# YouTube Data API v3 key (for lesson video search)
YOUTUBE_API_KEY=AIza...

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.com

# Comma-separated supported language codes
ALLOWED_LANGS=en,fr,pt,sw,es,hi

# Set to "true" to enable text-to-speech features
ENABLE_TTS=false
