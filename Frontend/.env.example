# Copy this file to .env.local (for local dev) or .env.production.local (for prod builds)
# and fill in the real values from your Firebase project console.
#
# These values are bundled into the browser build — they are NOT secret.
# Real security is enforced by Firebase Security Rules + authorized domain lists.

REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# Backend API base URL
REACT_APP_API_URL=https://somaai-jfuq.onrender.com
